			<staticText>
				<reportElement x="19" y="64" width="530" height="43" uuid="9a61c9a8-205d-4a02-8178-95b60b4396b9">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified">
					<font fontName="Nikosh" size="12"/>
				</textElement>
				<text><![CDATA[উল্লেখিত গাড়ী আমার নামে মালিকানা বদলী করিলে মালিকানা সংক্রান্ত কাগজপত্রে কোন জটিলতা সৃষ্টি হইলে উহার সম্পূর্ণ দায়-দায়িত্ব আমি/আমরা বহন করিব। বি.আর.টি.এ কর্তৃপক্ষ কোন দায় দায়িত্ব বহন করিবে না। উপরোক্ত বিবরণ পড়িয়া এবং শুনিয়া উহার মর্ম বুঝিয়া কাহারো প্ররোচনায় প্ররোচিত না হইয়া অন্যের বিনা অনুরোধে ও সুস্থ শরীরে, স্বজ্ঞানে অত্র হলফনামায় আমার/আমাদের নিজ নাম স্বাক্ষর করিলাম।]]></text>
			</staticText>
			<staticText>
